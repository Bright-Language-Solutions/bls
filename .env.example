# ------------------------------------------------------------------
# Bright Language Solutions — environment variables
# Copy to .env.local and fill in real values.
# Never commit .env.local to git.
# ------------------------------------------------------------------

# --- Database ----------------------------------------------------
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
DB_NAME=bls

# --- Public base URL ---------------------------------------------
NEXT_PUBLIC_BASE_URL=https://www.brightlanguagesolutions.com

# --- Admin -------------------------------------------------------
# Change this before deploying — any strong secret works
ADMIN_SECRET=bls-admin-change-me

# --- WhatsApp notifications (optional) ---------------------------
# Which provider lib/whatsapp.js should use: twilio | interakt | wati
# Leave unset to disable WhatsApp notifications entirely.
# WHATSAPP_PROVIDER=twilio

# Twilio (https://console.twilio.com)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Interakt (https://app.interakt.ai/settings/developer-setting)
# INTERAKT_API_KEY=

# WATI (https://app.wati.io/api-docs)
# WATI_API_KEY=
# WATI_API_ENDPOINT=https://live-server-xxxx.wati.io
